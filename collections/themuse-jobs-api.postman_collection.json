      "item": [
        {
          "id": "3d1536a0-7139-4f64-af91-7068149328fb",
          "name": "Search job openings",
          "request": {
            "name": "Search job openings",
            "description": {
              "content": "Returns a paginated list of job openings intelligently sorted by factors such as trendiness, uniqueness, and newness. Supports filtering by category, experience level, company, and location. Multiple values may be supplied for `category`, `level`, `company`, and `location` by repeating the query parameter. Returns up to 20 results per page.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "jobs"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "page",
                  "value": "1",
                  "description": "(Required) Page number of results to return (0-indexed pagination cursor)."
                },
                {
                  "disabled": false,
                  "key": "descending",
                  "value": "false",
                  "description": "Sort results in descending order when true."
                },
                {
                  "disabled": false,
                  "key": "category",
                  "value": "<string>",
                  "description": "Filter by job category, for example \"Data Science\", \"Design\", \"Software Engineering\", \"Sales\", or \"Accounting\". Repeat the parameter to filter on multiple categories."
                },
                {
                  "disabled": false,
                  "key": "level",
                  "value": "<string>",
                  "description": "Filter by experience level. One of \"Entry Level\", \"Mid Level\", \"Senior Level\", \"Management\", or \"Internship\". Repeat the parameter to filter on multiple levels."
                },
                {
                  "disabled": false,
                  "key": "company",
                  "value": "<string>",
                  "description": "Filter by company short name (for example \"hartfordhealthcare\"). Repeat the parameter to filter on multiple companies."
                },
                {
                  "disabled": false,
                  "key": "location",
                  "value": "<string>",
                  "description": "Filter by location, for example \"New York, NY\" or \"Flexible / Remote\". Repeat the parameter to filter on multiple locations."
                },
                {
                  "disabled": false,
                  "key": "api_key",
                  "value": "<string>",
                  "description": "Optional API key that raises the hourly rate limit."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
